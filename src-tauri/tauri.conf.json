{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalPlayer",
  "version": "0.5.13",
  "identifier": "com.localplayer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalPlayer",
        "width": 1180,
        "height": 720,
        "minWidth": 720,
        "minHeight": 460,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "desktop-entry.desktop"
      }
    },
    "fileAssociations": [
      {
        "ext": ["mp4", "mkv", "webm", "avi", "mov", "m4v", "mpg", "mpeg", "flv", "ts", "wmv"],
        "description": "Vídeo",
        "role": "Viewer",
        "mimeType": "video/mp4;video/x-matroska;video/webm;video/x-msvideo;video/quicktime;video/x-m4v;video/mpeg;video/x-flv;video/mp2t;video/x-ms-wmv"
      },
      {
        "ext": ["mp3", "flac", "m4a", "ogg", "opus", "wav", "aac", "wma"],
        "description": "Áudio",
        "role": "Viewer",
        "mimeType": "audio/mpeg;audio/flac;audio/mp4;audio/ogg;audio/opus;audio/x-wav;audio/aac;audio/x-ms-wma"
      }
    ],
    "resources": ["binaries/mpv/*", "third-party/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
